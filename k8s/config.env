# Replaces the compose .env. PORT and PROMETHEUS_PORT are also hardcoded as container/Service ports in web.yaml and
# prometheus.yaml (kustomize can't template numbers), so change them in both places.
PORT=8080
PROMETHEUS_PORT=9090
GOMEMLIMIT=256MiB
POSTGRES_USER=postgres
POSTGRES_DB=myapp
K6_PROMETHEUS_RW_SERVER_URL=http://prometheus:9090/api/v1/write
K6_PROMETHEUS_RW_TREND_AS_NATIVE_HISTOGRAM=true
